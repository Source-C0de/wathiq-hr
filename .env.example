# Copy to .env and fill in real values.
OPENAI_API_KEY=

# Qdrant (Docker service name resolves via docker-compose network).
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hrai_saudi_labour_law

# Embedding + LLM model names
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# App
APP_LANG=en               # default UI language: en | ar
APP_TOP_K=5
APP_RERANK=true