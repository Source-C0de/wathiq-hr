# Copy to .env and fill in real values.
# OPENAI_API_KEY is required; everything else has safe defaults.
OPENAI_API_KEY=

# Qdrant connection.
# - Inside Docker Compose: services talk to "qdrant" (the service name).
# - From your local machine: use localhost.
# The compose file overrides this to "qdrant" for the app/api/ingest services;
# change it here only if you run a service on the host network.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=wathiq_hr_law

# Embedding + LLM model names
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Embedding batch size
EMBED_BATCH_SIZE=32

# Optional app defaults
APP_LANG=en
APP_TOP_K=5
APP_RERANK=true

# Local SQLite path (relative paths are resolved inside the container / cwd).
WATHIQ_DB_PATH=monitoring/wathiq.db
